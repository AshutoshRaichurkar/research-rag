# Copy to .env and adjust. Never commit .env.

# Postgres + pgvector (matches docker-compose.yml)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=research_rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rag:rag@localhost:5432/research_rag

# Ollama runs natively on your Mac (uses the Apple GPU; Docker can't)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Chunking
CHUNK_SIZE=200
CHUNK_OVERLAP=40
